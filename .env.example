# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local ไม่ถูก commit)
# หาได้ที่ Supabase → Project Settings → API
#
# ไม่ใช่ความลับ: ค่าสองตัวนี้ถูกฝังใน bundle ที่ทุกคนโหลดได้อยู่แล้ว
# สิ่งที่กันคนแปลกหน้าคือ RLS ในฐานข้อมูล ไม่ใช่การซ่อนคีย์นี้
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# กุญแจสาธารณะสำหรับแจ้งเตือนขึ้นมือถือ (Web Push)
# ไม่ใช่ความลับ — คู่กับกุญแจลับที่เก็บไว้ใน Secrets ของ Edge Function notify-kitchen
# ไม่ตั้งก็ได้ แค่ปุ่มเปิดแจ้งเตือนในหน้าครัวจะไม่ขึ้น
VITE_VAPID_PUBLIC_KEY=
